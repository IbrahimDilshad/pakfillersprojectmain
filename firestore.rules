rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can only read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }
    
    // Chat sessions and messages
    match /chats/{sessionId} {
      // Admins can read the entire collection for querying/listing.
      // Individual users can only get their own session document.
      allow get: if request.auth.uid == sessionId || isAdmin();
      allow list, create, update: if isAdmin();
      
      // A user can create their own session.
      allow create: if request.auth.uid == sessionId;

      // An admin can delete any session.
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        // A user can read/create messages in their own session, or an admin can access any.
        allow read, create: if request.auth.uid == sessionId || isAdmin();
      }
    }

    // Public content that anyone can read, but only admins can write
    match /blogPosts/{postId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /faqs/{faqId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
