
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all reads and writes by default for maximum security.
    match /{document=**} {
      allow read, write: if false;
    }

    // isAdmin function now checks the auth token for a custom claim.
    // This is required for collection group queries (like listing all chats).
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    
    // isOwner function checks if the user is the owner of the document.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // USERS collection:
    match /users/{userId} {
      allow create: if request.auth.uid != null;
      allow read, update, delete: if isOwner(userId) || isAdmin();

      // Sub-accounts can be managed only by the parent user or an admin.
      match /subAccounts/{subAccountId} {
          allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ORDERS collection:
    match /orders/{orderId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read, update: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    // CHATS collection:
    // list access is now controlled by the isAdmin() function checking custom claims.
    match /chats/{sessionId} {
      allow list: if isAdmin();
      allow read, write: if isOwner(sessionId) || isAdmin();

      match /messages/{messageId} {
        allow read, write: if isOwner(sessionId) || isAdmin();
      }
    }

    // Publicly readable content that is only writable by admins.
    match /blogPosts/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /faqs/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /videos/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /formPrices/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /paymentMethods/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // NOTIFICATIONS collection:
    match /notifications/{notificationId} {
        allow read: if isOwner(resource.data.userId) || isAdmin();
        allow write: if isAdmin();
    }
  }
}
