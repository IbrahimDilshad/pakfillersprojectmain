rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // USERS collection
    // Users can read/write their own document
    // Admins can read/write any user document
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
      
      // Sub-accounts can be managed by the parent user
      match /subAccounts/{subAccountId} {
          allow read, write: if request.auth.uid == userId;
      }
    }
    
    // ORDERS collection
    // Users can create orders for themselves
    // Users can only read their own orders
    // Admins can read any order
    match /orders/{orderId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read, update: if request.auth.uid == resource.data.userId;
    }

    // CHATS collection
    // Users can read/write to their own chat session
    // Admins can read/write to any chat session for support
    match /chats/{sessionId} {
      allow read, write: if request.auth.uid == sessionId;

      match /messages/{messageId} {
        allow read, write: if request.auth.uid == sessionId;
      }
    }
    
    // Public Content Collections
    // Allow anyone to read, but only admins to write
    match /blogPosts/{postId} {
      allow read: if true;
    }
    
    match /services/{serviceId} {
        allow read: if true;
    }
    
    match /faqs/{faqId} {
        allow read: if true;
    }
    
    match /videos/{videoId} {
        allow read: if true;
    }

    match /formPrices/{formId} {
        allow read: if true;
    }
    
    match /paymentMethods/{methodId} {
        allow read: if true;
    }

    // Notifications
    // Users can only read their own notifications
    match /notifications/{notificationId} {
        allow read: if request.auth.uid == resource.data.userId;
    }
    
    // ADMIN-ONLY full access rules
    // This function checks for the 'admin' role in the user's custom claims or Firestore document
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
        allow read, write: if isAdmin();
    }
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    // Allow admins to list chats, and read/write any message within them.
    match /chats/{document=**} {
      allow read, write: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow write: if isAdmin();
    }
     match /services/{serviceId} {
      allow write: if isAdmin();
    }
     match /faqs/{faqId} {
      allow write: if isAdmin();
    }
     match /videos/{videoId} {
      allow write: if isAdmin();
    }
     match /formPrices/{formId} {
      allow write: if isAdmin();
    }
     match /paymentMethods/{methodId} {
      allow write: if isAdmin();
    }
     match /notifications/{notificationId} {
        allow read, write: if isAdmin();
    }
  }
}
