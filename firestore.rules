
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all reads and writes by default for maximum security.
    match /{document=**} {
      allow read, write: if false;
    }

    // isAdmin function checks if the requesting user has the 'admin' role.
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USERS collection:
    // - Users can create their own account.
    // - Users can read and update their own data.
    // - Admins can read and write to any user's document.
    match /users/{userId} {
      allow create: if request.auth.uid != null;
      allow read, update, delete: if request.auth.uid == userId || isAdmin();

      // Sub-accounts can be managed only by the parent user or an admin.
      match /subAccounts/{subAccountId} {
          allow read, write: if request.auth.uid == userId || isAdmin();
      }
    }

    // ORDERS collection:
    // - Users can create orders for themselves.
    // - Users can only read or update their own orders.
    // - Admins have full read/write access to all orders.
    match /orders/{orderId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read, update: if request.auth.uid == resource.data.userId || isAdmin();
      allow write: if isAdmin();
    }

    // CHATS collection:
    // - Admins are allowed to list all chat sessions for the dashboard.
    // - A user can only access their own chat session.
    // - Admins can access any chat session for support purposes.
    match /chats/{sessionId} {
      allow list: if isAdmin();
      allow read, write: if request.auth.uid == sessionId || isAdmin();

      match /messages/{messageId} {
        allow read, write: if request.auth.uid == sessionId || isAdmin();
      }
    }

    // Publicly readable content that is only writable by admins.
    match /blogPosts/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /faqs/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /videos/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /formPrices/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /paymentMethods/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // NOTIFICATIONS collection:
    // - A user can only read notifications intended for them.
    // - Admins have full access to manage notifications.
    match /notifications/{notificationId} {
        allow read: if request.auth.uid == resource.data.userId || isAdmin();
        allow write: if isAdmin();
    }
  }
}
