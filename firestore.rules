rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Get a user's role
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
    
    // Check if a user is an admin
    function isAdmin() {
      return getUserRole(request.auth.uid) == 'admin';
    }

    // Users collection rules
    match /users/{userId} {
      // A user can read and write to their own document
      allow read, update, delete: if request.auth.uid == userId;
      // Anyone can create their own user document (for signup)
      allow create: if request.auth.uid == userId;
      // Admins can read any user's document
      allow read: if isAdmin();
    }

    // Public content collections (blog, videos, etc.)
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chat collection rules
    // A user can read/write to their own chat session
    match /chats/{userId}/{message=**} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }
  }
}
