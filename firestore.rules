rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // This function checks for the 'admin' role in the user's Firestore document
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // USERS collection
    // Users can read/write their own document
    // Admins can read/write any user document
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid != null;
      
      // Sub-accounts can be managed by the parent user or an admin
      match /subAccounts/{subAccountId} {
          allow read, write: if request.auth.uid == userId || isAdmin();
      }
    }
    
    // ORDERS collection
    // Users can create orders for themselves
    // Users can only read their own orders
    // Admins can read/write any order
    match /orders/{orderId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read, update: if request.auth.uid == resource.data.userId || isAdmin();
      allow write: if isAdmin(); // Admins can write to any order
    }

    // CHATS collection
    // Admins can list all chats for the dashboard view
    // Users can read/write to their own chat session
    // Admins can read/write to any chat session for support
    match /chats/{sessionId} {
      allow list: if isAdmin();
      allow read, write: if request.auth.uid == sessionId || isAdmin();

      match /messages/{messageId} {
        allow read, write: if request.auth.uid == sessionId || isAdmin();
      }
    }
    
    // Public Content Collections
    // Allow anyone to read, but only admins to write
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /services/{serviceId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    match /faqs/{faqId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    match /videos/{videoId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /formPrices/{formId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    match /paymentMethods/{methodId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // NOTIFICATIONS collection
    // Users can only read their own notifications
    // Admins can read/write any notification
    match /notifications/{notificationId} {
        allow read: if request.auth.uid == resource.data.userId || isAdmin();
        allow write: if isAdmin();
    }
  }
}
