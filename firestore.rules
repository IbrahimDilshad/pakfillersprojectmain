
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is the hardcoded admin.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@example.com';
    }

    // Helper function to check if the requester is the owner of a document.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // --- Public Content Rules (Blog, Videos, FAQs, Services) ---
    // These collections should be readable by anyone but only writable by the admin.
    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // There is no longer a 'users' collection managed by the app for roles.

    // --- Chat Rules ---
    // This section governs the chat sessions and the messages within them.
    match /chats/{sessionId} {
      // Admins can list all chat sessions to populate their support dashboard.
      allow list: if isAdmin();
      // A user can get their own chat session. An admin can get any session.
      allow get: if isOwner(sessionId) || isAdmin();
      // A user can create/update their own session. An admin can also update any session.
      allow create, update: if isOwner(sessionId) || isAdmin();
      // Only admins should be able to delete entire chat histories.
      allow delete: if isAdmin();

      // Messages within a chat session
      match /messages/{messageId} {
        // The session owner (the user) and any admin can read and write messages.
        allow read, write: if isOwner(sessionId) || isAdmin();
      }
    }
  }
}
