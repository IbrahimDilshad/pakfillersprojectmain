
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requesting user has the 'admin' role.
    // It reads the user's document from the 'users' collection.
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if the user is the owner of a document.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Default rule: Deny all reads and writes to prevent unauthorized access.
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS collection rules
    match /users/{userId} {
      // A user can create their own user document during signup.
      allow create: if request.auth.uid == userId;
      // A user can read/update their own document. An admin can read/update any user document.
      allow read, update, delete: if isOwner(userId) || isAdmin();

      // SUB-ACCOUNTS sub-collection rules
      match /subAccounts/{subAccountId} {
          // Only the parent user or an admin can manage sub-accounts.
          allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ORDERS collection rules
    match /orders/{orderId} {
      // A user can create an order for themselves.
      allow create: if isOwner(request.resource.data.userId);
      // A user can read their own orders. Admins can read any order.
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Only an admin can update or delete an order.
      allow update, delete: if isAdmin();
    }
    
    // DOCUMENTS collection rules
    match /documents/{docId} {
      // Users can read their own documents, Admins and Accountants can read any document
      allow read: if isOwner(resource.data.userId) || request.auth.uid != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'accountant');
      // Admins and Accountants can list all documents
      allow list: if request.auth.uid != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'accountant');
      // Users can create their own documents
      allow create: if isOwner(request.resource.data.userId);
      // Admins and Accountants can update any document status. Users cannot update.
      allow update: if request.auth.uid != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'accountant');
      // Only Admins can delete documents
      allow delete: if isAdmin();
    }
    
    // TAX FILINGS collection rules
    match /taxFilings/{filingId} {
        allow read, list: if request.auth.uid != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'accountant');
        allow create, update: if isAdmin();
    }


    // CHATS collection rules
    match /chats/{sessionId} {
      // Admins can list all chat sessions for their dashboard view.
      allow list: if isAdmin() && request.query.orderBy.path.string() == "lastMessageTimestamp";
      // A user can read/write to their own chat session. Admins can access any chat.
      allow read, write: if isOwner(sessionId) || isAdmin();

      // MESSAGES sub-collection rules
      match /messages/{messageId} {
        // A user can read/write messages in their own chat session. Admins can access any.
        allow read, write: if isOwner(sessionId) || isAdmin();
      }
    }
    
    // NOTIFICATIONS collection rules
    match /notifications/{notificationId} {
        // A user can only read notifications intended for them.
        allow read: if isOwner(resource.data.userId);
        // Only admins can create/update/delete notifications.
        allow write: if isAdmin();
    }

    // Publicly readable collections that are only writable by admins.
    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /faqs/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /videos/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /formPrices/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /paymentMethods/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }
  }
}
