rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to check user roles and ownership
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Check the user's custom claim or their role in the 'users' collection
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isUser() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can read any user profile. Users can only read their own.
      allow read: if isOwner(userId) || isAdmin();
      
      // Any authenticated user can create their own user document (on signup).
      // They can't create a document for someone else.
      allow create: if isOwner(userId);

      // Users can update their own profile, but cannot change their role.
      // Admins can update any user profile.
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      
      // Deleting user documents should be handled by a backend process, not directly by clients.
      allow delete: if false;
      
      // Rules for the 'subAccounts' subcollection
      match /subAccounts/{subAccountId} {
        // Only the parent user can manage their sub-accounts.
        allow read, write, delete: if isOwner(userId);
      }
    }

    // Rules for the 'orders' collection
    match /orders/{orderId} {
      // Any authenticated user can create an order.
      allow create: if isUser();
      
      // Users can read their own orders. Admins can read all orders.
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Only admins can update (e.g., change status) or delete orders.
      allow update, delete: if isAdmin();
    }

    // Rules for the 'chats' collection
    match /chats/{sessionId} {
      // The session ID is the user's UID. Users can access their own chat session.
      // Admins can access any chat session.
      allow read, create, update: if isOwner(sessionId) || isAdmin();
      allow delete: if isAdmin();

      // Rules for the 'messages' subcollection within a chat
      match /messages/{messageId} {
         // Users can read messages in their own chat. Admins can read all messages.
        allow read: if isOwner(sessionId) || isAdmin();
        
        // Users can create messages in their own session. Admins can also send messages.
        allow create: if isOwner(sessionId) || isAdmin();
        
        // Only admins can update or delete specific messages.
        allow update, delete: if isAdmin();
      }
    }
    
    // Rules for admin-sent notifications
    match /notifications/{notificationId} {
        // Users can read notifications sent to them. Admins can read all.
        allow read: if isOwner(resource.data.userId) || isAdmin();
        // Only admins can create, update, or delete notifications.
        allow create, update, delete: if isAdmin();
    }

    // Read-only for public content, write access for admins
    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
     match /faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
     match /videos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
     match /formPrices/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
     match /paymentMethods/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
