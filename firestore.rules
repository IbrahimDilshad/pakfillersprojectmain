rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check for admin role
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // By default, deny all access.
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can read/update their own profile, admins can manage all profiles.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      
      // Rules for sub-accounts
      match /subAccounts/{subAccountId} {
        allow read, create, update, delete: if request.auth.uid == userId || isAdmin();
      }
    }
    
    // Public collections: read-only for authenticated users, full access for admins.
    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /faqs/{faqId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /blogPosts/{postId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Form prices can be read by anyone, but only written by admins.
    match /formPrices/{formId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }

    // Orders: Users can create orders and only read their own. Admins can manage all orders.
    match /orders/{orderId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read, update: if request.auth.uid == resource.data.userId || isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications: Users can only read their own notifications.
    match /notifications/{notificationId} {
        allow read: if request.auth.uid == resource.data.userId;
        allow update: if request.auth.uid == resource.data.userId; // For marking as read
        // No create/delete access for clients. Created via backend logic/admin actions.
    }

    // Payment Methods: All authenticated users can read, only admins can write.
    match /paymentMethods/{methodId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Chat: only participants (user or admin) can access chat sessions and messages.
    match /chats/{sessionId} {
      allow read, write: if request.auth.uid == sessionId || isAdmin();

      match /messages/{messageId} {
        allow read, create: if request.auth.uid == sessionId || isAdmin();
      }
    }
  }
}