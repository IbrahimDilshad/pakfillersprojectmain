
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Publicly readable content, writable only by admins
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chat sessions and messages
    match /chats/{sessionId} {
      // Admins can list all chat sessions. Users can get their own.
      allow list: if isAdmin();
      allow get: if request.auth.uid == sessionId || isAdmin();

      // Users can create/update their own session document. Admins can update any.
      allow create: if request.auth.uid == sessionId;
      allow update: if request.auth.uid == sessionId || isAdmin();
      allow delete: if isAdmin();

      // Messages can be read by the session owner or an admin.
      // Messages can be created by the session owner or an admin.
      match /messages/{messageId} {
        allow read, write: if request.auth.uid == sessionId || isAdmin();
        allow update, delete: if false; // Disallow updates/deletes to preserve chat history.
      }
    }
    
    // User data can only be read by the user themselves or an admin.
    // Users can only create their own user document and cannot assign a role.
    // Users can update their own document, but cannot change their role.
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId && !("role" in request.resource.data);
      allow update: if request.auth.uid == userId && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }
  }
}
