rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is an authenticated admin.
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if the requester is the owner of the document.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // --- Public Content Rules ---
    // Anyone can read, only admins can write.
    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      // Admins can view any user's profile. Users can only view their own.
      allow get: if isOwner(userId) || isAdmin();
      // Only admins can list all users.
      allow list: if isAdmin();
      // Users can create their own profile upon signup, but cannot assign a role.
      allow create: if isOwner(userId) && !("role" in request.resource.data);
      // Users can update their own profile, but cannot change their role.
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    // --- Chat Rules ---
    match /chats/{sessionId} {
      // Admins can list all chat sessions to see who needs support.
      allow list: if isAdmin();
      // A user can get their own chat session. An admin can get any session.
      allow get: if isOwner(sessionId) || isAdmin();
      // A user can create/update their session. An admin can also update any session.
      allow create, update: if isOwner(sessionId) || isAdmin();
      // Only admins can delete entire chat histories.
      allow delete: if isAdmin();

      // Messages within a chat session
      match /messages/{messageId} {
        // The session owner and admins can write messages. Reading is handled below.
        allow write: if isOwner(sessionId) || isAdmin();
        // Disallow updating or deleting messages to maintain chat integrity.
        allow update, delete: if false;
      }
    }
    
    // This rule gives admins recursive read access to all documents (including all messages subcollections)
    // under any chat session, which is required for the admin support panel.
    match /chats/{sessionId}/{document=**} {
      allow read: if isAdmin();
    }
  }
}
