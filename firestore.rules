rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is an authenticated admin.
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if the requester is the owner of the document.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // --- Public Content Rules ---
    // Anyone can read, only admins can write.
    match /blogPosts/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /videos/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /services/{docId} { allow read: if true; allow write: if isAdmin(); }

    // --- User Profile Rules ---
    match /users/{userId} {
      // Admins can view any user's profile. Users can only view their own.
      allow get: if isOwner(userId) || isAdmin();
      // Only admins can list all users.
      allow list: if isAdmin();
      // Users can create their own profile upon signup, but cannot assign a role.
      allow create: if isOwner(userId) && !("role" in request.resource.data);
      // Users can update their own profile, but cannot change their role.
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    // --- Chat Rules ---
    match /chats/{sessionId} {
      allow list: if isAdmin();
      allow get: if isOwner(sessionId) || isAdmin();
      allow create, update: if isOwner(sessionId) || isAdmin();
      allow delete: if isAdmin();

      // Messages can be written by the session owner or an admin.
      // Reading is handled by the recursive rule below.
      match /messages/{messageId} {
        allow write: if isOwner(sessionId) || isAdmin();
        // Disallow updating/deleting to preserve history
        allow update, delete: if false;
      }
    }

    // This is the critical rule: it gives admins recursive read access
    // to all documents and subcollections within the 'chats' collection.
    // This is necessary for the admin support dashboard to function correctly.
    match /chats/{sessionId}/{document=**} {
      allow read: if isAdmin();
    }
  }
}