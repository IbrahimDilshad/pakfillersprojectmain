rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    // - Users can read their own profile.
    // - Users can update their own profile.
    // - Admins can read any user profile.
    // - Sub-accounts can be managed by their parent user or an admin.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId);
      allow list: if isAdmin();

      match /subAccounts/{subAccountId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // CONTENT (Services, Blog, FAQs, Videos, Form Prices)
    // - Anyone can read public content.
    // - Only admins can create, update, or delete content.
    match /services/{docId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }
    match /blogPosts/{docId} {
       allow get: if true;
       allow list: if true;
       allow write: if isAdmin();
    }
     match /faqs/{docId} {
       allow get: if true;
       allow list: if true;
       allow write: if isAdmin();
    }
     match /videos/{docId} {
       allow get: if true;
       allow list: if true;
       allow write: if isAdmin();
    }
     match /formPrices/{docId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }
    match /paymentMethods/{docId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // ORDERS
    // - Users can create their own orders.
    // - Users can only read/list their own orders.
    // - Admins can read/list/update/delete any order.
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    // NOTIFICATIONS
    // - Admins can create notifications for any user.
    // - Users can only read/update their own notifications.
    match /notifications/{notificationId} {
      allow create: if isAdmin();
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // CHAT
    // - A user can create/update their own chat session.
    // - Admins can create/update any chat session.
    // - Users can read/write messages in their own chat session.
    // - Admins can read/write messages in any chat session.
    match /chats/{sessionId} {
      allow read, write: if isOwner(sessionId) || isAdmin();

      match /messages/{messageId} {
        allow read, write: if isOwner(sessionId) || isAdmin();
      }
    }
  }
}
