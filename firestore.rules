rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return isRole('admin');
    }

    function isAccountant() {
        return isRole('accountant');
    }
    
    // Default Deny: Secure by default
    match /{document=**} {
      allow read, write: if false;
    }

    // USER DATA
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      // Sub-accounts can only be managed by the parent user or an admin
      match /subAccounts/{subAccountId} {
          allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // ORDERS
    match /orders/{orderId} {
      allow create: if isOwner(request.resource.data.userId);
      // User can read own orders. Admin and Accountant can read all orders.
      allow read: if isOwner(resource.data.userId) || isAdmin() || isAccountant();
      allow update, delete: if isAdmin();
    }

    // CHAT
    match /chats/{sessionId} {
      // Admins can list all sessions, ordered by timestamp.
      allow list: if isAdmin();
      // User can read/write their own session. Admins can access any session.
      allow read, write: if isOwner(sessionId) || isAdmin();

      match /messages/{messageId} {
        allow read, write: if isOwner(sessionId) || isAdmin();
      }
    }
    
    // NOTIFICATIONS (Pushed by backend/admin, read by user)
    match /notifications/{notificationId} {
        allow read: if isOwner(resource.data.userId);
        allow write: if isAdmin();
    }
    
    // DOCUMENTS (Submitted by users, managed by admin/accountant)
    match /documents/{docId} {
        // User can create their own document.
        allow create: if isOwner(request.resource.data.userId);
        // User can read own document. Admins and Accountants can read all.
        allow read: if isOwner(resource.data.userId) || isAdmin() || isAccountant();
        // Admins and Accountants can update status. Only Admins can delete.
        allow update: if isAdmin() || isAccountant();
        allow delete: if isAdmin();
    }
    
    // TAX FILINGS (Submitted by users, managed by accountant/admin)
    match /taxFilings/{filingId} {
        allow create: if isOwner(request.resource.data.userId);
        allow read, update: if isOwner(resource.data.userId) || isAdmin() || isAccountant();
        allow delete: if isAdmin();
    }

    // PUBLIC/ADMIN-MANAGED CONTENT
    // Anyone can read, only admins can write.
    match /blogPosts/{docId}   { allow read: if true; allow write: if isAdmin(); }
    match /services/{docId}    { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{docId}        { allow read: if true; allow write: if isAdmin(); }
    match /videos/{docId}      { allow read: if true; allow write: if isAdmin(); }
    match /formPrices/{docId}  { allow read: if true; allow write: if isAdmin(); }
    match /paymentMethods/{docId} { allow read: if true; allow write: if isAdmin(); }
  }
}