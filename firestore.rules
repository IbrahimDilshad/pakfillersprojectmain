rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for Admin role
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if a user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users can only read/write their own profile
    // Admins can read/write any profile
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if request.auth != null;
    }
    
    // Sub-accounts can be managed by the parent user or an admin
    match /users/{parentUid}/subAccounts/{subAccountId} {
       allow read, create, update, delete: if isOwner(parentUid) || isAdmin();
    }

    // Public content is readable by all, but only writable by admins
    match /blogPosts/{postId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /videos/{videoId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
     match /services/{serviceId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Orders can be created by any authenticated user for themselves.
    // Users can read their own orders. Admins can read/update/delete any order.
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow get, list: if isOwner(resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // Filings work similarly to orders
     match /filings/{filingId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow get, list: if isOwner(resource.data.userId);
      allow update, delete: if isAdmin();
    }
    
    // Chat sessions can be read/written by the user or an admin
    match /chats/{sessionId} {
      allow read, write: if isOwner(sessionId) || isAdmin();
      
      // Messages can be read by the user or an admin
      // Messages can only be created by the user who owns the session or an admin
      match /messages/{messageId} {
         allow read, create: if isOwner(sessionId) || isAdmin();
      }
    }
    
    // Notifications can be read by the owner, created by an admin, and updated by the owner (to mark as read)
    match /notifications/{notificationId} {
       allow get, list: if isOwner(resource.data.userId);
       allow create: if isAdmin();
       allow update: if isOwner(resource.data.userId); // For marking as read
    }
  }
}