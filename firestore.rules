rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can only read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }
    
    // Chat sessions and messages
    match /chats/{sessionId} {
      // User can interact with their own chat session. Admin can interact with any.
      allow read, write, create: if request.auth.uid == sessionId || isAdmin();
      
      match /messages/{messageId} {
        allow read, write, create: if request.auth.uid == sessionId || isAdmin();
      }
    }

    // Public content that anyone can read
    match /blogPosts/{postId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /faqs/{faqId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Default deny all other access to prevent unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}