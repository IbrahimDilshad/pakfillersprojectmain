
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user has the 'admin' role.
    function isAdmin() {
      // The admin's role is checked via their email, not a database read.
      return request.auth.token.email == 'admin@example.com';
    }

    // Helper function to check if the user is the owner of the document.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to check if the user is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // USERS collection:
    // - Authenticated users can create their own user document.
    // - Users can read/update their own profile.
    // - Admins can read/update any profile.
    match /users/{userId} {
      allow create: if isAuthenticated();
      allow read, update: if isOwner(userId) || isAdmin();

      // SUB-ACCOUNTS:
      // - Only the parent user or an admin can manage sub-accounts.
      match /subAccounts/{subAccountId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // CHATS collection:
    // - Admins can list all chat sessions.
    // - Users can read/write to their own chat session. Admins can access any.
    match /chats/{sessionId} {
      allow list, read, write, delete: if isAdmin();
      allow read, write: if isOwner(sessionId);
      
      // MESSAGES sub-collection:
      // - Permissions are inherited from the parent /chats/{sessionId} document.
      match /messages/{messageId} {
         allow read, write: if isOwner(sessionId) || isAdmin();
      }
    }

    // ORDERS collection:
    // - Authenticated users can create their own orders.
    // - Admins can list all orders.
    // - A user can read their own order. Admins can read any.
    // - Admins can update or delete any order.
    match /orders/{orderId} {
      allow create: if isOwner(request.resource.data.userId);
      allow list: if isAdmin();
      allow read: if isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    // NOTIFICATIONS collection:
    // - Admins can create notifications.
    // - Users can read/update notifications intended for them.
    // - Admins can manage any notification.
    match /notifications/{notificationId} {
      allow create, delete: if isAdmin();
      allow read, update: if isOwner(get(/databases/$(database)/documents/notifications/$(notificationId)).data.userId) || isAdmin();
    }

    // PUBLIC CONTENT (Blog, Videos, FAQs, Services, Payment Methods)
    // - Anyone can read this content.
    // - Only admins can modify this content.
    match /{collectionId}/{docId} {
      allow read: if collectionId in ['blogPosts', 'videos', 'faqs', 'services', 'paymentMethods'];
      allow create, update, delete: if isAdmin() && collectionId in ['blogPosts', 'videos', 'faqs', 'services', 'paymentMethods'];
    }
  }
}
