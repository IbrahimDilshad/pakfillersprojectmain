
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for admin role based on email
    function isAdmin() {
      return request.auth.token.email == 'admin@example.com';
    }

    // Publicly readable content, only writable by admins
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chat functionality
    match /chats/{userId} {
      // Allow user to create their chat session document, or admin to read it.
      allow get, list: if request.auth.uid == userId || isAdmin();
      allow create, update: if request.auth.uid == userId;

      // Messages subcollection
      match /messages/{messageId} {
        // Allow user to read/write their own messages, and admin to read any message.
        allow read: if request.auth.uid == userId || isAdmin();
        allow create: if request.auth.uid == userId || isAdmin();
      }
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
