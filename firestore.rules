
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // By default, deny all reads and writes.
    match /{document=**} {
      allow read, write: if false;
    }

    // This function checks the user's auth token for a custom claim.
    // This is the correct way to handle roles for collection-group queries.
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // USERS collection
    match /users/{userId} {
      // A user can create their own document.
      allow create: if request.auth.uid != null;
      // A user can read/update their own data, or an admin can.
      allow read, update, delete: if request.auth.uid == userId || isAdmin();

      // Sub-accounts are controlled by the parent user or an admin.
      match /subAccounts/{subAccountId} {
          allow read, write: if request.auth.uid == userId || isAdmin();
      }
    }

    // ORDERS collection
    match /orders/{orderId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read, update: if request.auth.uid == resource.data.userId || isAdmin();
      allow write: if isAdmin();
    }

    // CHATS collection
    // Admins can list all chats for their dashboard.
    // An individual user can only access their own chat session.
    match /chats/{sessionId} {
      allow list: if isAdmin();
      allow read, write: if request.auth.uid == sessionId || isAdmin();

      match /messages/{messageId} {
        allow read, write: if request.auth.uid == sessionId || isAdmin();
      }
    }

    // Publicly readable content that is only writable by admins.
    match /blogPosts/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /faqs/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /videos/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /formPrices/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
    match /paymentMethods/{doc=**} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // NOTIFICATIONS collection
    match /notifications/{notificationId} {
        allow read: if request.auth.uid == resource.data.userId || isAdmin();
        allow write: if isAdmin();
    }
  }
}
