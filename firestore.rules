
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role from the users collection
    function isAdmin() {
      // Check if the user is authenticated and has an 'admin' role in their user document.
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Public content can be read by anyone, but only written by an admin.
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins can list all chat sessions.
    // Users can only access their own session document.
    match /chats/{sessionId} {
      allow list: if isAdmin();
      allow get: if request.auth.uid == sessionId || isAdmin();
      allow create, update: if request.auth.uid == sessionId;
      
      // Messages can be read by the session owner or an admin.
      // Messages can only be created by the session owner or an admin.
      match /messages/{messageId} {
        allow read, create: if request.auth.uid == sessionId || isAdmin();
        allow update, delete: if false; // Disallow updates/deletes to preserve chat history.
      }
    }
    
    // User documents can be read by the owner or an admin.
    // A user can create their own document.
    // A user can update their own document, but CANNOT change their role.
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId && request.resource.data.role == resource.data.role;
    }
  }
}
