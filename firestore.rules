rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for admin role
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection
    // - Users can create their own profile on signup.
    // - Users can read and update their own data.
    // - Admins can read any user's data.
    // - Users cannot change their own role.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role; // Prevent role change
      allow delete: if false; // Nobody can delete user profiles directly
    }

    // Sub-accounts: Only the parent user can manage their sub-accounts.
    match /users/{parentUserId}/subAccounts/{subAccountId} {
        allow read, write, delete: if isOwner(parentUserId);
    }
    
    // Orders Collection
    // - Users can create their own orders.
    // - Users can read their own orders.
    // - Admins can read, update, and delete any order.
    match /orders/{orderId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    // Chats Collection (Sessions)
    // - A user can create/update their own chat session.
    // - Admins can read/write to any session for support purposes.
    match /chats/{sessionId} {
      allow read, write: if isOwner(sessionId) || isAdmin();
      allow delete: if isAdmin(); // Only admins can delete chat history
      
      // Messages Subcollection
      // - A user can write messages to their own session.
      // - Admins can write messages to any session.
      // - Both can read messages in the relevant session.
      match /messages/{messageId} {
        allow read, write: if isOwner(sessionId) || isAdmin();
      }
    }
    
    // Notifications Collection
    // - Admins can create notifications for any user.
    // - Users can read their own notifications.
    // - Users can update the 'isRead' status of their own notifications.
    match /notifications/{notificationId} {
      allow create: if isAdmin();
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }
    
    // Payment Methods: Only accessible by admins
    match /paymentMethods/{methodId} {
        allow read, write, delete: if isAdmin();
    }

    // Public or Admin-managed content (Read for all, Write for admin)
    match /faqs/{faqId} {
        allow read: if true;
        allow write, delete: if isAdmin();
    }
    
    match /videos/{videoId} {
        allow read: if true;
        allow write, delete: if isAdmin();
    }
    
    match /blogPosts/{postId} {
        allow read: if true;
        allow write, delete: if isAdmin();
    }
    
    match /services/{serviceId} {
        allow read: if true;
        allow write, delete: if isAdmin();
    }
    
    match /formPrices/{formId} {
        allow read: if true;
        allow write, delete: if isAdmin();
    }
  }
}
